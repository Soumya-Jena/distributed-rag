DATABASE_URL=postgresql://rag:rag@localhost:5432/ragdb
DATABASE_URL_SCALE=postgresql://rag:rag@localhost:5432/ragdb_scale
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GENERATION_MODEL=Qwen/Qwen2.5-1.5B-Instruct
MAX_NEW_TOKENS=180
MIN_RETRIEVAL_SIMILARITY=0.30
CHUNK_SIZE=100
CHUNK_OVERLAP=20
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RETRIEVAL_CANDIDATE_K=20
RERANK_TOP_K=5
USE_RERANKER=false
RETRIEVAL_MODE=hybrid
LEXICAL_CANDIDATE_K=20
HYBRID_CANDIDATE_K=20
RRF_K=60
GROUNDING_MODE=strict
SECURITY_MODE=layered
QUERY_TRANSFORM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
QUERY_VARIANTS=3
QUERY_TRANSFORM_ENABLED=true
CONTEXT_STRATEGY=full
CONTEXT_DEDUP_THRESHOLD=0.92
CONTEXT_KEEP_RATIO=0.50
CONTEXT_TOKEN_BUDGET=1000
CONTEXT_NEIGHBOR_WINDOW=0
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
EMBEDDING_CACHE_TTL=86400
TRANSFORM_CACHE_TTL=86400
RETRIEVAL_CACHE_TTL=3600
RESPONSE_CACHE_TTL=600
RESPONSE_CACHE_ENABLED=false
OBSERVABILITY_ENABLED=true
METRICS_SERVER_ENABLED=false
METRICS_PORT=9108
OTEL_EXPORTER=none
OTEL_ENDPOINT=http://localhost:4318/v1/traces
LOG_LEVEL=INFO
